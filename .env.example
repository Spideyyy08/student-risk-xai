APP_NAME=Student Academic Risk System
ENVIRONMENT=development

# MySQL (Docker container exposes host port 3307 to avoid clashing with a local MySQL on 3306)
MYSQL_ROOT_PASSWORD=rootpass_dev
MYSQL_DATABASE=student_risk
MYSQL_USER=risk_user
MYSQL_PASSWORD=risk_pass_dev
MYSQL_HOST_PORT=3307
DATABASE_URL=mysql+pymysql://risk_user:risk_pass_dev@localhost:3307/student_risk

# JWT
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (frontend is served by FastAPI, so this only matters if you use Live Server)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:5500